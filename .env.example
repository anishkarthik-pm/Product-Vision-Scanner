# ===========================================
# API Keys (choose one based on your needs)
# ===========================================

# Google Gemini API Key (Recommended for this project)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative name
GOOGLE_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Alternative option)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# Optional Configuration
# ===========================================

# Gemini model (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Claude model (default: claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Max tokens for response
MAX_TOKENS=4096
